# Copy to backend/.env for running the API directly on your machine (uv run uvicorn ...).
# Inside docker-compose these are set by docker-compose.yml from the root .env instead.

ENVIRONMENT=local
# Host is `localhost` when the API runs on your machine and `db` inside docker-compose.
DATABASE_URL=postgresql+psycopg://jobtrack:jobtrack@localhost:5432/jobtrack
CORS_ORIGINS=["http://localhost:5173"]
