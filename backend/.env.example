# Copy to backend/.env for running the API directly on your machine (uv run uvicorn ...).
# Inside docker-compose these are set by docker-compose.yml from the root .env instead.

ENVIRONMENT=local
# Host is `localhost` when the API runs on your machine and `db` inside docker-compose.
DATABASE_URL=postgresql+psycopg://jobtrack:jobtrack@localhost:5432/jobtrack
CORS_ORIGINS=["http://localhost:5173"]

# Auth. Production requires a random 32+ char JWT secret and REFRESH_COOKIE_SECURE=true.
JWT_SECRET_KEY=dev-only-insecure-jwt-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_SECURE=false
# Re-presenting a token rotated less than this many seconds ago is treated as a race, not theft.
REFRESH_REUSE_GRACE_SECONDS=10

# Database connection hardening.
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=20000
# Production on Neon: DATABASE_URL = pooled endpoint, this = direct endpoint (see docs/deployment.md).
# MIGRATION_DATABASE_URL=

# Tests use a separate database (created automatically). Default shown.
# TEST_DATABASE_URL=postgresql+psycopg://jobtrack:jobtrack@localhost:5432/jobtrack_test
