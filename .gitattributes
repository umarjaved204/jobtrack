# Normalize line endings to LF in the repo (important on Windows: shell scripts and
# Dockerfiles break with CRLF inside Linux containers).
* text=auto eol=lf

*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff2 binary

# Pinned upstream file, checked byte for byte against its Hugging Face revision
# (tests/test_match_tokenizer.py): never normalise it.
backend/app/services/match/*.tokenizer.json -text
