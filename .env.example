# Root env file, read by docker-compose. Copy to `.env` (git-ignored) and adjust.
# Local-dev values only; real secrets live in the Render / Vercel / Neon dashboards.

POSTGRES_USER=jobtrack
POSTGRES_PASSWORD=jobtrack
POSTGRES_DB=jobtrack

# Signs access tokens. Any value works locally; production needs a random 32+ char secret:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-jwt-secret-change-me

# Host ports. Change these if something else already uses them.
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173
