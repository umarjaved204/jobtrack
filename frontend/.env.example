# Copy to frontend/.env.local for running `pnpm dev` on your machine.
# Dev-server settings only. Variables prefixed with VITE_ are exposed to browser code,
# so never put secrets in this file.

# Where Vite proxies /api/* in dev (docker-compose sets http://backend:8000).
API_PROXY_TARGET=http://localhost:8000
# Set to true if HMR doesn't pick up file changes (e.g. inside Docker on Windows).
VITE_USE_POLLING=false
